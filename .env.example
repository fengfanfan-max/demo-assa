# Copy to .env.local and fill in. Both keys are OPTIONAL:
#   - without keys, the app runs on the bundled SERP fixture + cached sample analysis
#   - with keys, it fetches a live SERP (Serper.dev) and runs live LLM analysis

# Serper.dev key for live Google SERP (US, English). https://serper.dev
SERPER_API_KEY=

# Data-source mode: "live" (real Google SERP) | "fixture" (bundled snapshots) | unset = auto
# Convenience scripts: npm run dev:fixture / npm run dev:live
SERP_MODE=

# LLM key for live analysis — ANY OpenAI-compatible provider works
# (DeepSeek, Moonshot, OpenRouter, SiliconFlow, OpenAI, ...).
# Defaults point at DeepSeek; override base URL/model for other providers.
OPENAI_API_KEY=
# OPENAI_BASE_URL=https://api.deepseek.com
# OPENAI_MODEL=deepseek-chat
